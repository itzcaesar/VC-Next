{
  "name": "voice-changer-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:release": "npm run build && npm run release:prepare",
    "preview": "vite preview",
    "tauri": "tauri",
    "release:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-release.ps1",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-release.ps1",
    "runtime:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-runtime.ps1",
    "validate:reference": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-reference-validation.ps1",
    "validate:route": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-live-route-validation.ps1",
    "validate:native-route": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-native-route-validation.ps1",
    "validate:native-speech": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-native-speech-loopback.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
